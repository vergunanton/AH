{
  "codeConnect": {
    "parser": "react",
    "include": ["src/components/**/*.figma.ts", "src/components/ui/**/*.figma.ts"],
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/components/ui/*": ["src/components/ui/*"]
    },
    "importPaths": {
      "src/components/*": "@/components",
      "src/components/ui/*": "@/components/ui"
    }
  }
}
